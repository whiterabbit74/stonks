# Primary domain
{$DOMAIN:mktorder.com} {
  # Override with TLS_CA=https://acme-staging-v02.api.letsencrypt.org/directory only for testing
  tls {
    ca {$TLS_CA:https://acme-v02.api.letsencrypt.org/directory}
  }

  encode gzip
  log {
    output file /var/log/caddy/access.log
  }

  request_body {
    max_size 5MB
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    -Server
  }

  # Stock caddy:2 has no rate_limit module (that needs github.com/mholt/caddy-ratelimit,
  # which we will not vendor into prod). Login brute-force and API abuse are limited
  # in-process by the Go server.

  # Trading API
  handle /api/** {
    reverse_proxy server:3001
  }

  # MCP (ChatGPT / clients)
  handle /mcp/transcribe* {
    reverse_proxy mcp:8080
  }

  # Music server (ytplayer / musicplay) under /music — not in this compose;
  # it lives on the VPS in a separate stack. Missing upstream → 502.
  # /music/foo → musicplay:3001/foo
  redir /music /music/ permanent
  handle_path /music/* {
    reverse_proxy musicplay:3001
  }

  # Go SPA + API (same process as /api)
  handle {
    reverse_proxy server:3001
  }
}

# Legacy domain → permanent redirect (path + query preserved, including /music/*)
tradingibs.site {
  tls {
    ca {$TLS_CA:https://acme-v02.api.letsencrypt.org/directory}
  }

  redir https://mktorder.com{uri} permanent
}

# Separate app on the same Caddy instance (not in this repo's compose).
macdiff.com {
  encode gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  reverse_proxy macdiff:8080 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}
