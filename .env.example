# Copy to ~/stonks-config/.env on the VPS (chmod 600) or export locally.
# Never commit a filled copy.

DOMAIN=mktorder.com
TLS_CA=https://acme-v02.api.letsencrypt.org/directory
BUILD_ID=production

PORT=3001
GO_ENV=production
TRUST_PROXY=true

ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
PREFERRED_API_PROVIDER=alpha_vantage

MCP_BEARER_TOKENS=
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://mktorder.com

WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_ACCOUNT_ID=
# Opt-in. Unset = disabled.
# WEBULL_ENABLE_LIVE_TEST_BUY=true
WEBULL_API_PROTOCOL=https:
WEBULL_API_HOST=api.webull.com
WEBULL_API_PORT=

DB_FILE=/data/db/trading.db
DATASETS_DIR=/data/datasets
DB_DIR=/data/db
SETTINGS_FILE=/data/state/settings.json
WATCHES_FILE=/data/state/telegram-watches.json
SPLITS_FILE=/data/state/splits.json
TRADE_HISTORY_FILE=/data/state/trade-history.json
HTTP_LOG_PATH=/data/state/http-access.jsonl

PRICE_ACTUALIZATION_REQUEST_DELAY_MS=15000
PRICE_ACTUALIZATION_DELAY_JITTER_MS=2000
