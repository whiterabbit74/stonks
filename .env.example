# Copy to ~/stonks-config/.env on the VPS (chmod 600) or export locally.
# Never commit a filled copy.

DOMAIN=mktorder.com
TLS_CA=https://acme-v02.api.letsencrypt.org/directory
BUILD_ID=production

PORT=3001
GO_ENV=production
TRUST_PROXY=true
# Extra Origin allowed on mutating /api/ requests. Same-host is always ok.
# FRONTEND_ORIGIN=https://mktorder.com

ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
PREFERRED_API_PROVIDER=alpha_vantage

MCP_BEARER_TOKENS=
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://mktorder.com

WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_ACCOUNT_ID=
# Fallback expiry when the DB token row has none.
# WEBULL_TOKEN_EXPIRES_AT=
# Opt-in. Unset = disabled. Quantity default 1, hard cap 100.
# WEBULL_ENABLE_LIVE_TEST_BUY=true
# WEBULL_LIVE_TEST_BUY_MAX_QUANTITY=1
# ROBINHOOD_ENABLE_LIVE_TEST_BUY=true
WEBULL_API_PROTOCOL=https:
WEBULL_API_HOST=api.webull.com
WEBULL_API_PORT=

DB_FILE=/data/db/trading.db
DATASETS_DIR=/data/datasets
HTTP_LOG_PATH=/data/state/http-access.jsonl

PRICE_ACTUALIZATION_REQUEST_DELAY_MS=15000
PRICE_ACTUALIZATION_DELAY_JITTER_MS=2000
